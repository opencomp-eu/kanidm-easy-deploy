# kanidm-easy-deploy — operator configuration
# Copy to deploy.yaml and run: bash apply.sh

kanidm:
  domain: idm.example.com
  image: docker.io/kanidm/server
  tag: "1.11.1"
  tools_image: docker.io/kanidm/tools
  tools_tag: "1.11.1"
  data_dir: /var/lib/kanidm
  # LDAP is always enabled on the container network (ldaps://kanidm:3636).
  ldap: true

# Optional portal branding (replaces Kanidm's default Ferris logo on sign-in).
branding:
  display_name: Example Organisation
  # Local path (relative to this repo) or https URL. Omit to use the bundled default.
  # logo: branding/my-logo.svg
  # Set OAuth2 application icons from each client's landing page favicon (default: true).
  oauth2_icons: true
  # Login background is assets/branding/background.jpg (CSS overlay; not the 256 KB logo limit).

proxy:
  type: caddy
  # standalone — this kit runs its own Caddy on :443 (single-service VPS)
  # integrate — join easydeploy-net; easydeploy-engine owns Caddy (multi-service VPS)
  mode: standalone
  integrate:
    network: easydeploy-net

# Initial people created on first apply. Kanidm remains the source of truth
# after that — manage users and groups in Kanidm, not in the apps.
users:
  - username: operator
    display_name: Admin
    email: admin@example.com
    groups:
      - opencloud-admin
      - opencloud-user
      - matrix-admins
      - mail-users

# Groups created on apply so OpenCloud / Matrix / Stalwart role mapping works.
groups:
  - opencloud-admin
  - opencloud-user
  - opencloud-guest
  - matrix-admins
  - mail-users

oidc:
  enabled: true
  # Engine writes extra clients to .kanidm-easy-deploy/integration/oidc-clients.d/
  clients: []
  # Per-client overrides (optional):
  #   - client_id: opencloud
  #     image: branding/opencloud.png   # local path or URL; set false to skip

# Kanidm Admin UI — web console for managing Kanidm itself (people, groups,
# OAuth2 apps) at https://admin.<organisation domain>. Enabled by default;
# set enabled: false to omit it.
admin_ui:
  enabled: true
  # domain: admin.example.com          # override the admin.<org domain> default
  # image: ghcr.io/opencomp-eu/kanidm-admin-ui
  # tag: v0.2.0
  # admin_group: idm_admins            # group whose members may log in
# Optional Borg backups (local directory or SFTP off-site repository).
# Kanidm's embedded database is file-based: prefer 'bash backup.sh --cold'
# for scheduled runs so the data dir is captured while the stack is stopped.
backup:
  enabled: false
  repository:
    # type: local — repository on this VPS
    type: local
    path: /var/backups/kanidm
    encryption: repokey

    # type: sftp — incremental off-site backups (recommended for crash recovery)
    # type: sftp
    # host: backup.example.com
    # user: borg
    # path: /repos/kanidm
    # port: 22
    # ssh_key_path: /root/.ssh/borg_backup
    # host_key_check: true
  schedule:
    enabled: false
    calendar: "*-*-* 03:00:00"
    persistent: true
  retention:
    keep_daily: 7
    keep_weekly: 4
    keep_monthly: 6
    keep_yearly: 0
